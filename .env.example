PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/forester.sqlite
APP_ORIGIN=http://localhost:5173
# Production: NODE_ENV=production, APP_ORIGIN=https://your-domain, HTTPS reverse proxy.
# Initial dispatcher (npm run db:init):
# INIT_USERNAME=dispecer
# INIT_PASSWORD=unique-password-at-least-12-characters
# SESSION_HOURS=12
# Vercel / Neon (server only; never use a VITE_ prefix for secrets):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/forester?sslmode=require
# APP_ORIGIN=https://your-forester-domain.vercel.app
# INIT_USERNAME=dispecer
# INIT_PASSWORD=your-unique-initial-password
